# DeepSeek（推荐，不要把真实 Key 提交到 Git）
DEEPSEEK_API_KEY=
# 可选：默认已是 https://api.deepseek.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选模型：deepseek-v4-flash（默认）或 deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-v4-flash

# 通用别名（与上面等价，任选其一）
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash
# LLM_PROVIDER=deepseek

# Cloudflare Tunnel 等外网场景建议开启访问口令
# ECHO_ACCESS_PASSWORD=

# Harness 插件调用本机 Echo 时使用（默认 http://127.0.0.1:3000）
# ECHO_TASK_URL=http://127.0.0.1:3000
